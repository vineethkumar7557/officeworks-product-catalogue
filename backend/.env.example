# Copy this file to backend/.env and change values if you need to.
# Never put real secrets in this example file.

# Where the backend listens
PORT=3000

# Fake Store API (the product data source)
FAKE_STORE_BASE_URL=https://fakestoreapi.com
FAKE_STORE_TIMEOUT_MS=5000
# How long we keep Fake Store answers in memory before asking again
CACHE_TTL_SECONDS=300

# The 5 products shown on the home page, in order.
# Chosen as the top rated products (checked against the Fake Store data).
FEATURED_PRODUCT_IDS=12,11,3,18,5

# Email: Mailpit catches all mail locally. Web inbox: http://localhost:8025
# (docker-compose overrides SMTP_HOST with "mailpit" inside Docker)
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=catalogue@example.com
SALES_INBOX_EMAIL=sales@example.com

# Allow at most this many enquiries per window from one IP address
ENQUIRY_RATE_LIMIT_MAX=5
ENQUIRY_RATE_LIMIT_WINDOW_MINUTES=15

# Which web origin may call the API from a browser
CORS_ORIGIN=http://localhost:3000
